# Copy to .env and fill in real values. Never commit .env.

# --- application ---
APP_NAME=scalable-rag
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=*

# --- language model ---
OPENAI_API_KEY=sk-your-openai-key
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
EMBEDDING_MODEL=text-embedding-3-small

# --- documents ---
# local -> read DOCS_DIR, s3 -> read S3_BUCKET_NAME/S3_PREFIX
DOCUMENT_SOURCE=local
DOCS_DIR=docs
DOCUMENT_EXTENSIONS=.txt,.md,.markdown,.rst,.pdf
S3_BUCKET_NAME=your-corpus-bucket
S3_PREFIX=docs/
AWS_REGION=us-east-1
# Only needed outside AWS (on EKS prefer an IAM role for the service account)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
# Skip documents larger than this during ingestion (0 disables the check).
MAX_DOCUMENT_MB=25

# --- retrieval ---
INDEX_PATH=faiss_index
RETRIEVAL_K=5
MAX_QUESTION_LENGTH=2000

# --- auth ---
# Set AUTH_ENABLED=false for local development only.
AUTH_ENABLED=true
# HS256 -> JWT_SECRET, RS256 -> JWT_JWKS_URL
JWT_ALGORITHM=HS256
JWT_SECRET=your-shared-signing-secret
JWT_JWKS_URL=https://your-issuer.example.com/.well-known/jwks.json
JWT_AUDIENCE=scalable-rag
JWT_ISSUER=https://your-issuer.example.com/

# --- observability ---
MLFLOW_ENABLED=false
MLFLOW_TRACKING_URI=http://mlflow.internal:5000
MLFLOW_EXPERIMENT=scalable-rag
